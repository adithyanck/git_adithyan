void print(char *p)
{
    while(*p != 0)
    {
        data(*p);
        p++;
    }
}

void command(int a)
{
   
    PORTB = a;
    PORTD = 0x40;
    _delay_ms(300);
    PORTD = 0x00;
    
    
}

void data(char c)
{
    
    
    
    PORTB = c;
    PORTD = 0x60;
    _delay_ms(300);
    PORTD = 0x20;
}
