#define F_CPU 8000000UL
#include <util/delay.h>
#include <avr/io.h>
void command (int a);
void  data(char c);


void main(void)
{
    int a,b[4],i;
    DDRA=0x00;
    DDRC=0xFF;
    DDRD=0xFF;
    
    ADMUX=0X40;
    ADCSRA=0XC0;
    
    command(0x01);
    command(0x38);
    command(0x06);
    command(0x0F);
    command(0x80);
    command(0x0c);
    while(1)
    {
        ADCSRA=0XC0;
        while((ADCSRA&0X40)==1);
        
            int a = ADCL|(ADCH<<8);
            for(i=3;i>=0;i--)
            {
               b[i]=(a%10)+48;
               a=a/10;
            }
            command(0x80);
            for(i=0;i<4;i++)
            {
                data(b[i]);
                
            }
            _delay_ms(300);
            //command(0x01);
    }
    return;
}
void command(int a)
{
    PORTD=a;
    
    PORTC=0X02;
    _delay_ms(100);
    PORTC=0X00;
}
void data(char b)
{
    PORTD=b;
    
    PORTC=0X03;
    _delay_ms(50);
    PORTC=0X01;
}

